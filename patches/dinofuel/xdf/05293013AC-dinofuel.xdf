<?xml version="1.0" encoding="utf-8"?>
<XDFFORMAT version="1.60">
 <XDFHEADER>
  <flags>0x1</flags>
  <deftitle>SBEC3 05293013AC - DinoFuel experimental</deftitle>
  <description>Only for the DinoFuel-patched 128 KB image, not the original ROM. Base pulse counts before WOT enrichment and barometric correction. Fixed axis labels match the original MAP scale and RPM nodes. Do not edit axes or use this prototype on a vehicle.</description>
  <BASEOFFSET offset="0" subtract="0" />
  <DEFAULTS datasizeinbits="16" sigdigits="5" outputtype="1" signed="0" lsbfirst="0" float="0" />
  <REGION type="0xFFFFFFFF" startaddress="0x0" size="0x20000" regionflags="0x0" name="Binary" desc="SBEC3 DinoFuel experimental image" />
  <CATEGORY index="0x0" name="DinoFuel" />
 </XDFHEADER>
 <XDFTABLE uniqueid="0x101" flags="0x0">
  <title>DinoFuel Part Throttle</title>
  <description>Unsigned big-endian 16-bit absolute base pulse table. Stored word = 2 x base pulse counts. The stock fuel correction table remains in use outside the MAP scale. Axis labels are fixed; do not use with changed stock MAP scale or RPM axis.</description>
  <CATEGORYMEM index="0" category="1" />
  <XDFAXIS id="x" uniqueid="0x0">
   <units>rpm</units>
   <indexcount>17</indexcount>
   <outputtype>4</outputtype>
   <DALINK index="0" />
   <MATH equation="X"><VAR id="X" /></MATH>
   <LABEL index="0" value="512" />
