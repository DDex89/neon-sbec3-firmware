   <LABEL index="14" value="5760" />
   <LABEL index="15" value="6208" />
   <LABEL index="16" value="7200" />
  </XDFAXIS>
  <XDFAXIS id="y" uniqueid="0x0">
   <units>kPa (stock MAP scale)</units>
   <indexcount>17</indexcount>
   <outputtype>4</outputtype>
   <DALINK index="0" />
