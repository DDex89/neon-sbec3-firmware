  <deftitle>SBEC3 04887050 - DinoFuel V2 Q11 - experimental</deftitle>
  <description>V2 Q11 only. Fixed axes; unsigned Q2.14 fuel multiplier, 1.0 = stock linear base. Never use with V1 or stock ROM. Simulation and disconnected bench only.</description>
  <BASEOFFSET offset="0" subtract="0" />
  <DEFAULTS datasizeinbits="16" sigdigits="5" outputtype="1" signed="0" lsbfirst="0" float="0" />
